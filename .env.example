# CI/frontend build inputs. These are baked into the public frontend image and
# do not belong in the server runtime `.env`.
VITE_SITE_URL=https://ivan.hubko.me
VITE_CONTACT_API_URL=https://ivan.hubko.me/api/contact
VITE_GA4_MEASUREMENT_ID=G-
VITE_GITHUB_URL=https://github.com/Bruno-116aff
VITE_LINKEDIN_URL=https://www.linkedin.com/in/ivan-hubko-5a635b245

# Server runtime configuration (stored only beside the production compose)
SITE_HOST=ivan.hubko.me
TRAEFIK_NETWORK=traffic_net

# Contact API (server-side only; do not prefix with VITE_)
CONTACT_RATE_LIMIT_WINDOW_SECONDS=60
CONTACT_RATE_LIMIT_MAX_REQUESTS=5

# Telegram notification module (server-side only; keep the real values out of Git)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
