VITE_SITE_URL=https://ivan.hubko.me
VITE_CONTACT_API_URL=https://ivan.hubko.me/api/contact
VITE_GA4_MEASUREMENT_ID=
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=

# Deployment (user-owned VPS/Traefik configuration)
SITE_HOST=ivan.hubko.me
BARE_HOST=hubko.me
CV_HOST=cv.hubko.me
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=
# Keep both values as 'self' until GA4 is explicitly enabled. If it is enabled,
# append the documented Google origins from docs/04-tech-spec.md.
FRONTEND_CSP_SCRIPT_SRC='self'
FRONTEND_CSP_CONNECT_SRC='self'

# Contact API (server-side only; do not prefix with VITE_)
CONTACT_API_PORT=3001
CONTACT_ALLOWED_ORIGIN=https://ivan.hubko.me
CONTACT_RATE_LIMIT_WINDOW_SECONDS=60
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
CONTACT_DATABASE_PATH=./data/contact.sqlite
