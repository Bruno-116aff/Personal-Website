{
  "name": "ivan-hubko-site-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:contact-api": "npm --prefix apps/contact-api run start:dev",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:contact-api",
    "typecheck:frontend": "npm --prefix apps/frontend run typecheck",
    "typecheck:contact-api": "npm --prefix apps/contact-api run typecheck",
    "test": "npm run test:frontend && npm run test:contact-api",
    "test:frontend": "npm --prefix apps/frontend run test",
    "test:contact-form": "npm --prefix apps/frontend run test:contact-form",
    "test:contact-api": "npm --prefix apps/contact-api run test",
    "build": "npm run build:frontend && npm run typecheck:contact-api",
    "build:frontend": "npm --prefix apps/frontend run build",
    "lint": "npm --prefix apps/frontend run lint",
    "format": "npm --prefix apps/frontend run format",
    "format:check": "npm --prefix apps/frontend run format:check",
    "verify:frontend": "npm --prefix apps/frontend run verify:frontend",
    "verify:accessibility": "npm --prefix apps/frontend run verify:accessibility",
    "verify:performance": "npm --prefix apps/frontend run verify:performance",
    "verify:content": "npm --prefix apps/frontend run verify:content",
    "verify:meta": "npm --prefix apps/frontend run verify:meta",
    "verify:deployment": "npm --prefix apps/frontend run verify:deployment",
    "verify:production": "npm --prefix apps/frontend run verify:production",
    "verify": "node scripts/verify.mjs",
    "dev:config": "docker compose --env-file .env -f infra/docker-compose.dev.yml config",
    "dev:up": "docker compose --env-file .env -f infra/docker-compose.dev.yml up -d --build",
    "dev:down": "docker compose -f infra/docker-compose.dev.yml down",
    "dev:logs": "docker compose -f infra/docker-compose.dev.yml logs -f --tail=200",
    "prod:config": "docker compose --env-file .env -f infra/docker-compose.prod.yml config",
    "prod:build": "docker compose --env-file .env -f infra/docker-compose.prod.yml -f infra/docker-compose.build.yml build",
    "prod:pull": "docker compose --env-file .env -f infra/docker-compose.prod.yml pull frontend contact-api",
    "prod:up": "docker compose --env-file .env -f infra/docker-compose.prod.yml up -d",
    "prod:down": "docker compose --env-file .env -f infra/docker-compose.prod.yml down",
    "prod:logs": "docker compose --env-file .env -f infra/docker-compose.prod.yml logs -f --tail=200",
    "prod:ps": "docker compose --env-file .env -f infra/docker-compose.prod.yml ps"
  }
}
