{
  "name": "@ivan-hubko/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:contact-form": "tsx --test src/lib/contact-form.spec.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify:frontend": "npm run typecheck && npm run build",
    "verify:accessibility": "node scripts/verify-accessibility.mjs",
    "verify:performance": "node scripts/verify-performance.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:meta": "node scripts/verify-meta.mjs",
    "test": "npm run test:contact-form"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
